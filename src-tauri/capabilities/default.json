{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window. Grants access to the plugins polyrocket uses end-to-end: SQLite (sql), OS (env + paths), shell (open URL), and notification (system toasts). v0.7c.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    "core:app:default",
    "core:path:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "os:default",
    "shell:default",
    "shell:allow-open",
    "notification:default",
    "notification:allow-notify",
    "notification:allow-request-permission",
    "notification:allow-is-permission-granted",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
