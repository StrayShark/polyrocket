# ============================================================
# polyrocket configuration template
# ============================================================
# 1) copy to .env:   cp .env.example .env
# 2) fill in your real values
# 3) .env is in .gitignore — never committed
#
# SECURITY MODEL
#   - v0.2 dev:     app reads .env on startup and syncs API keys
#                   into macOS Keychain (service: com.polyrocket.wallet).
#                   Keys never land in SQLite or git history.
#   - v0.3+:       set POLYROCKET_KEYRING_ONLY=1 to skip .env
#                   reads and require keys already in Keychain.
#   - LLM API keys  → Keychain entry "llm/<provider-id>/<alias>"
#   - Polymarket   → Keychain entry "polyrocket/pm/api"
#   - Wallet pk    → Keychain entry "polyrocket/wallet/<address>"
# ============================================================


# ---------------- app ---------------------
RUST_LOG=info
POLYROCKET_ENV=dev                 # dev | staging | prod
POLYROCKET_KEYRING_ONLY=0          # 1 = skip .env, require keychain
POLYROCKET_DB_PATH=                # default = ~/Library/Application Support/com.polyrocket.app/polyrocket.db


# ---------------- LLM: OpenAI ----------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-2024-08-06
OPENAI_KEY_ALIAS=openai-prod-1     # alias written to keychain
OPENAI_DISPLAY_NAME=GPT-4o
OPENAI_TIMEOUT_MS=30000
OPENAI_COST_PER_1K_IN=0.250        # USD cents
OPENAI_COST_PER_1K_OUT=1.000
OPENAI_RATE_LIMIT_RPM=500
OPENAI_QUOTA_DAILY_CENTS=200.0     # hard daily cap, optional
OPENAI_QUOTA_MONTHLY_CENTS=5000.0


# ---------------- LLM: Anthropic ----------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
ANTHROPIC_KEY_ALIAS=anthropic-prod-1
ANTHROPIC_DISPLAY_NAME=Claude Sonnet 4.5
ANTHROPIC_TIMEOUT_MS=30000
ANTHROPIC_COST_PER_1K_IN=0.300
ANTHROPIC_COST_PER_1K_OUT=1.500
ANTHROPIC_RATE_LIMIT_RPM=400
ANTHROPIC_QUOTA_DAILY_CENTS=300.0
ANTHROPIC_QUOTA_MONTHLY_CENTS=8000.0


# ---------------- LLM: Google Gemini ----------------
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_DEFAULT_MODEL=gemini-2.5-pro
GOOGLE_KEY_ALIAS=google-prod-1
GOOGLE_DISPLAY_NAME=Gemini 2.5 Pro
GOOGLE_TIMEOUT_MS=30000
GOOGLE_COST_PER_1K_IN=0.125
GOOGLE_COST_PER_1K_OUT=0.500
GOOGLE_RATE_LIMIT_RPM=300
GOOGLE_QUOTA_DAILY_CENTS=200.0
GOOGLE_QUOTA_MONTHLY_CENTS=5000.0


# ---------------- LLM: DeepSeek ----------------
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
DEEPSEEK_KEY_ALIAS=deepseek-prod-1
DEEPSEEK_DISPLAY_NAME=DeepSeek V3
DEEPSEEK_TIMEOUT_MS=30000
DEEPSEEK_COST_PER_1K_IN=0.014
DEEPSEEK_COST_PER_1K_OUT=0.028
DEEPSEEK_RATE_LIMIT_RPM=350
DEEPSEEK_QUOTA_DAILY_CENTS=20.0
DEEPSEEK_QUOTA_MONTHLY_CENTS=300.0


# ---------------- LLM: backup keys (optional) ----------------
# Add 2nd/3rd key per provider for failover/round-robin
# The Rust side reads these on startup and writes to keychain
# alongside the primary key above.
OPENAI_BACKUP_KEY=
OPENAI_BACKUP_ALIAS=openai-backup
ANTHROPIC_BACKUP_KEY=
ANTHROPIC_BACKUP_ALIAS=anthropic-backup


# ---------------- LLM: custom OpenAI-compat proxy (optional) ----------------
# Example: OpenRouter / Azure / 自建转发
CUSTOM_LLM_ENABLED=0               # 0 = skip, 1 = include in parallel fan-out
CUSTOM_LLM_NAME=OpenRouter
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=https://openrouter.ai/api/v1
CUSTOM_LLM_DEFAULT_MODEL=anthropic/claude-sonnet-4.5
CUSTOM_LLM_KEY_ALIAS=openrouter-prod-1
CUSTOM_LLM_TIMEOUT_MS=30000


# ---------------- Polymarket CLOB API ----------------
# https://docs.polymarket.com/#authentication
# Three values required for L2 API auth (signed requests).
# Get them by running `polyrocket` once and using the "Connect wallet" flow,
# or via PMM Web UI → Settings → API Keys.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137            # polygon mainnet


# ---------------- Wallet (mode B — signed betting) ----------------
# 0x... hex private key, 64 chars (without 0x prefix)
# Used to sign CTF / CTF Exchange orders.  KMS / hardware wallet
# integration planned for v0.3.
POLYROCKET_WALLET_PRIVATE_KEY=
POLYROCKET_WALLET_ADDRESS=         # 0x...  (informational, validated against pk)
POLYROCKET_WALLET_ALIAS=primary    # keychain key = polyrocket/wallet/primary


# ---------------- Daily Brief / scheduler (optional) ----------------
DAILY_BRIEF_HOUR_UTC=0             # 0..23
DAILY_BRIEF_TOP_N=8
DAILY_BRIEF_CACHE_TTL_HOURS=24
HEALTH_PROBE_INTERVAL_MIN=5        # 5min background health probe


# ---------------- Logging / telemetry (optional) ----------------
POLYROCKET_TELEMETRY=0             # 0 = off (default), 1 = on
SENTRY_DSN=
