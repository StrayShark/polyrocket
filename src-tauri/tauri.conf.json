{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "polyrocket",
  "version": "0.1.0",
  "identifier": "com.polyrocket.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "polyrocket",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Polymarket analysis desktop client",
    "longDescription": "polyrocket — local-first Polymarket analysis for football, CS2 and politics. Local SQLite, bet placement (Jump / Signed), P&L tracking and copy-trader analysis."
  },
  "plugins": {
    "sql": {
      "preload": []
    }
  }
}