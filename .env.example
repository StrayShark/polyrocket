# ============================================================
# polyrocket — DEV-ONLY configuration file
# ============================================================
# IMPORTANT — the .env file is a *development convenience*, not the
# primary configuration path. In normal use the user pastes API keys
# directly into the desktop client (Settings → LLM Management →
# Add key) and the secret is written straight to the OS keyring
# (macOS Keychain / Windows Credential Manager / Linux Secret Service).
#
# This .env file is consumed ONLY when BOTH conditions are true at
# startup:
#   1) POLYROCKET_ENV=dev
#   2) POLYROCKET_KEYRING_ONLY=0  (the default)
#
# If either flag is missing, the .env file is IGNORED entirely and
# the client-paste path is the only source of secrets.
#
# In production builds (cargo build --release) you would never set
# POLYROCKET_ENV=dev, so this file is never read.
#
# To use it:
#   cp .env.example .env       # (.env is in .gitignore)
#   vim .env                   # fill in real keys
#   POLYROCKET_ENV=dev pnpm tauri dev
#
# NEVER commit .env to git. NEVER paste a real key in a chat /
# screenshot / issue tracker.
# ============================================================


# ---------------- dev gate ----------------
POLYROCKET_ENV=dev                 # dev | staging | prod  (default: empty = no .env)
POLYROCKET_KEYRING_ONLY=0          # 1 = skip .env, require keychain (default: 0)
RUST_LOG=info


# ---------------- LLM: OpenAI ----------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-2024-08-06
OPENAI_DISPLAY_NAME=GPT-4o
OPENAI_TIMEOUT_MS=30000
OPENAI_COST_PER_1K_IN=0.250
OPENAI_COST_PER_1K_OUT=1.000
OPENAI_RATE_LIMIT_RPM=500
OPENAI_QUOTA_DAILY_CENTS=200.0
OPENAI_QUOTA_MONTHLY_CENTS=5000.0
# optional 2nd key for failover / round-robin
OPENAI_BACKUP_KEY=


# ---------------- LLM: Anthropic ----------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
ANTHROPIC_DISPLAY_NAME=Claude Sonnet 4.5
ANTHROPIC_TIMEOUT_MS=30000
ANTHROPIC_COST_PER_1K_IN=0.300
ANTHROPIC_COST_PER_1K_OUT=1.500
ANTHROPIC_RATE_LIMIT_RPM=400
ANTHROPIC_QUOTA_DAILY_CENTS=300.0
ANTHROPIC_QUOTA_MONTHLY_CENTS=8000.0
ANTHROPIC_BACKUP_KEY=


# ---------------- LLM: Google Gemini ----------------
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_DEFAULT_MODEL=gemini-2.5-pro
GOOGLE_DISPLAY_NAME=Gemini 2.5 Pro
GOOGLE_TIMEOUT_MS=30000
GOOGLE_COST_PER_1K_IN=0.125
GOOGLE_COST_PER_1K_OUT=0.500
GOOGLE_RATE_LIMIT_RPM=300
GOOGLE_QUOTA_DAILY_CENTS=200.0
GOOGLE_QUOTA_MONTHLY_CENTS=5000.0


# ---------------- LLM: DeepSeek ----------------
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
DEEPSEEK_DISPLAY_NAME=DeepSeek V3
DEEPSEEK_TIMEOUT_MS=30000
DEEPSEEK_COST_PER_1K_IN=0.014
DEEPSEEK_COST_PER_1K_OUT=0.028
DEEPSEEK_RATE_LIMIT_RPM=350
DEEPSEEK_QUOTA_DAILY_CENTS=20.0
DEEPSEEK_QUOTA_MONTHLY_CENTS=300.0


# ---------------- LLM: custom OpenAI-compat proxy (optional) ----------------
CUSTOM_LLM_ENABLED=0
CUSTOM_LLM_NAME=OpenRouter
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=https://openrouter.ai/api/v1
CUSTOM_LLM_DEFAULT_MODEL=anthropic/claude-sonnet-4.5
CUSTOM_LLM_TIMEOUT_MS=30000


# ---------------- Polymarket CLOB API ----------------
# https://docs.polymarket.com/#authentication
# In normal use these are pasted into Settings → Wallets & CLOB → API Keys.
# Here they are only seeded into the OS keyring when POLYROCKET_ENV=dev.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137


# ---------------- Wallet (mode B — signed betting) ----------------
# 64 hex chars, optional 0x prefix. Normally pasted in Settings → Wallets.
POLYROCKET_WALLET_PRIVATE_KEY=
POLYROCKET_WALLET_ADDRESS=
POLYROCKET_WALLET_ALIAS=primary


# ---------------- Daily Brief / scheduler (optional) ----------------
DAILY_BRIEF_HOUR_UTC=0
DAILY_BRIEF_TOP_N=8
DAILY_BRIEF_CACHE_TTL_HOURS=24
HEALTH_PROBE_INTERVAL_MIN=5


# ---------------- Telemetry (optional) ----------------
POLYROCKET_TELEMETRY=0
SENTRY_DSN=
